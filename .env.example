# Racine — docker-compose lit ce fichier. Voir backend/.env.example et frontend/.env.example pour le détail.
JWT_SECRET=replace-with-a-32-chars-minimum-random-secret
JWT_EXPIRES_IN=24h
DATABASE_DRIVER=mongodb
MONGODB_URI=mongodb://mongodb:27017/gabconcours
MONGODB_DB_NAME=gabconcours
CORS_ORIGINS=http://localhost:8001,http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:3001/api/v1
